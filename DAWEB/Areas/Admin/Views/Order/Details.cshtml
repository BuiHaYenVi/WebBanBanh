@model DAWEB.Models.OrderModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.OrderCode;
    var orderDetails = ViewBag.OrderDetails as List<DAWEB.Models.OrderDetailModel> ?? new List<DAWEB.Models.OrderDetailModel>();
}

<style>
    .order-item-img-admin {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }
</style>

<div class="container-fluid">
    <div class="mb-3">
        <a href="/Admin/Order" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách đơn hàng
        </a>
    </div>



    <div class="row g-4">
        <!-- Thông tin đơn hàng & Người nhận -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="m-0 fw-bold text-dark"><i class="fas fa-info-circle text-primary me-2"></i> Thông tin đơn hàng</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless m-0">
                        <tr>
                            <td class="text-muted ps-0">Mã đơn hàng:</td>
                            <td class="fw-bold text-primary text-end" style="font-family: monospace; font-size: 1.1rem;">@Model.OrderCode</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Tài khoản đặt:</td>
                            <td class="fw-semibold text-end">@Model.UserName</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Thời gian đặt:</td>
                            <td class="text-end">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Tổng tiền:</td>
                            <td class="fw-bold text-danger text-end fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Trạng thái thanh toán:</td>
                            <td class="text-end">
                                @if (Model.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i> Chưa thanh toán</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Trạng thái đơn hàng:</td>
                            <td class="text-end">
                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i> Chờ duyệt</span>
                                }
                                else if (Model.Status == "Completed")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Đã duyệt</span>
                                }
                                else if (Model.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i> Đã hủy</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="m-0 fw-bold text-dark"><i class="fas fa-truck text-success me-2"></i> Thông tin giao hàng</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless m-0">
                        <tr>
                            <td class="text-muted ps-0" style="width: 130px;">Họ tên người nhận:</td>
                            <td class="fw-semibold">@Model.ReceiverName</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Số điện thoại:</td>
                            <td class="fw-semibold">@Model.ReceiverPhone</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Địa chỉ giao:</td>
                            <td>@Model.ReceiverAddress</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Hình thức nhận:</td>
                            <td class="fw-semibold text-primary">@Model.DeliveryMethod</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Phí giao hàng:</td>
                            <td class="fw-bold text-dark">@Model.ShippingFee.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Phương thức thanh toán:</td>
                            <td>
                                <strong>
                                    @(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng (COD)" : (Model.PaymentMethod == "PayOS" ? "Thanh toán trực tuyến qua PayOS" : "Chuyển khoản ngân hàng"))
                                </strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Chi tiết sản phẩm & Hành động duyệt -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="m-0 fw-bold text-dark"><i class="fas fa-birthday-cake text-warning me-2"></i> Danh sách bánh đã đặt</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover m-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Ảnh</th>
                                    <th>Tên bánh</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-3">Tổng cộng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in orderDetails)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "/images/no-image.png" : item.Product.ImageUrl)" 
                                                 alt="@item.ProductName" 
                                                 class="order-item-img-admin" 
                                                 onerror="this.src='/images/no-image.png';" />
                                        </td>
                                        <td>
                                            <div class="fw-bold">@item.ProductName</div>
                                            @if (item.Product != null)
                                            {
                                                <div class="text-muted small">@item.Product.ProductSize</div>
                                            }
                                        </td>
                                        <td class="text-center">@item.Price.ToString("N0") đ</td>
                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                        <td class="text-end pe-3 fw-bold text-danger">@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                    </tr>
                                }
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="ps-3 py-2 text-muted">Giảm giá Voucher (@Model.VoucherCode):</td>
                                        <td class="text-end pe-3 py-2 text-success fw-bold">-@Model.DiscountAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                                @if (Model.ShippingFee > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="ps-3 py-2 text-muted">Phí giao hàng:</td>
                                        <td class="text-end pe-3 py-2 text-dark fw-bold">+@Model.ShippingFee.ToString("N0") đ</td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="ps-3 py-3">Tổng thanh toán:</td>
                                    <td class="text-end pe-3 py-3 text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Thao tác duyệt/hủy -->
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body d-flex gap-3 justify-content-end">
                    @if (Model.Status == "Pending")
                    {
                        <form action="/Admin/Order/Deliver/@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn BẮT ĐẦU GIAO ĐƠN HÀNG này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-lg px-4 py-2 text-dark" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                                <i class="fas fa-truck-loading me-2"></i> Bắt đầu giao hàng
                            </button>
                        </form>

                        <form action="/Admin/Order/Cancel/@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-lg px-4 py-2" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                                <i class="fas fa-ban me-2"></i> Hủy đơn hàng
                            </button>
                        </form>
                    }
                    else if (Model.Status == "Delivering")
                    {
                        <form action="/Admin/Order/ConfirmDelivered/@Model.Id" method="post" onsubmit="return confirm('Xác nhận Shipper đã giao thành công đơn hàng này cho khách?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg px-4 py-2" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                                <i class="fas fa-check-circle me-2"></i> Xác nhận đã giao xong
                            </button>
                        </form>
                        <span class="btn btn-secondary btn-lg px-4 py-2 disabled" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                            <i class="fas fa-motorcycle me-2"></i> Đang giao cho khách...
                        </span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <form action="/Admin/Order/Cancel/@Model.Id" method="post" onsubmit="return confirm('Đơn hàng đã được duyệt trước đó. Bạn có chắc chắn muốn hủy đơn hàng này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-lg px-4 py-2" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                                <i class="fas fa-ban me-2"></i> Hủy đơn hàng đã duyệt
                            </button>
                        </form>
                        <span class="btn btn-success btn-lg px-4 py-2 disabled" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                            <i class="fas fa-check-double me-2"></i> Đã duyệt hoàn tất
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="btn btn-danger btn-lg px-4 py-2 disabled" style="border-radius: 30px; font-size: 0.95rem; font-weight: 600;">
                            <i class="fas fa-times me-2"></i> Đơn hàng đã bị hủy
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
