@model IEnumerable<DAWEB.Models.ProductModels>
@{
    ViewData["Title"] = "Quản lý Tồn Kho (Stock)";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white pt-4 pb-3">
        <h4 class="text-primary mb-1"><i class="fas fa-boxes"></i> Trạng thái Kho hàng</h4>
        <p class="text-muted small mb-0">Các sản phẩm sắp hết hàng sẽ được ưu tiên hiển thị lên trên cùng.</p>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Mã SP</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Tồn kho hiện tại</th>
                        <th class="pe-4">Thao tác nhanh (+ Nhập)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-bold">#@item.Id</td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                            </td>
                            <td class="fw-bold">@item.ProductName</td>
                            <td class="text-danger fw-bold">@item.ProductPrice.ToString("#,##0 đ")</td>
                            <td>
                                @if (item.ProductQuantity == 0)
                                {
                                    <span class="badge bg-danger fs-6 px-3 py-2 shadow-sm">HẾT HÀNG (0)</span>
                                }
                                else if (item.ProductQuantity <= 5)
                                {
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 shadow-sm">SẮP HẾT (@item.ProductQuantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2 shadow-sm">CÒN HÀNG (@item.ProductQuantity)</span>
                                }
                            </td>
                            <td class="pe-4">
                                <form asp-action="AddStock" method="post" class="d-flex align-items-center" style="max-width: 250px;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <div class="input-group input-group-sm shadow-sm">
                                        <input type="number" name="addQuantity" class="form-control" placeholder="Số lượng..." min="1" required />
                                        <button type="submit" class="btn btn-primary px-3 fw-bold">+ Nhập</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>