@model IEnumerable<DAWEB.Models.FeedbackModel>
@{
    ViewData["Title"] = "Quản lý Góp Ý & Khiếu Nại";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h1 class="h3 mb-0 text-gray-800" style="font-family: 'Playfair Display', serif; font-weight: 700; color: #4e342e;">
            <i class="fas fa-comments text-warning me-2"></i> Quản lý Hộp Thư Góp Ý
        </h1>
    </div>



    <div class="card shadow mb-4" style="border-radius: 15px; overflow: hidden; border: none;">
        <div class="card-header py-3 bg-white d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Tin nhắn từ Khách hàng</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Trạng thái</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Nội dung tin nhắn</th>
                            <th>Ngày gửi</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fs-1 mb-3 text-light"></i>
                                    <p class="mb-0 fs-5">Chưa có góp ý hoặc khiếu nại nào.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="@(!item.IsRead ? "fw-bold bg-light" : "")">
                                    <td class="ps-4">
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fas fa-envelope me-1"></i> Chưa xử lý</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-double me-1"></i> Đã xử lý</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <span>@item.CustomerName</span>
                                        </div>
                                    </td>
                                    <td class="text-primary">
                                        <a href="tel:@item.Phone" class="text-decoration-none">
                                            <i class="fas fa-phone-alt me-1"></i> @item.Phone
                                        </a>
                                    </td>
                                    <td style="max-width: 300px;">
                                        <div class="text-truncate" title="@item.Message">
                                            @item.Message
                                        </div>
                                    </td>
                                    <td class="text-muted">
                                        @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (!item.IsRead)
                                            {
                                                <form action="/Admin/Feedback/MarkAsRead/@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success shadow-sm rounded-start" title="Đánh dấu đã xử lý">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form action="/Admin/Feedback/Delete/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa góp ý này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger shadow-sm @(!item.IsRead ? "rounded-end" : "rounded")" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
