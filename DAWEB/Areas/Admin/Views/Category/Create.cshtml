@model CategoryModel
@{
    ViewData["Title"] = "Thêm Danh mục Mới";
}

<div class="card shadow border-0" style="border-radius: 16px; max-width: 600px; margin: 0 auto;">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="m-0 font-weight-bold" style="font-family: 'Playfair Display', serif; color: var(--primary-brown);">Thêm Danh mục Mới</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="POST">
            @Html.AntiForgeryToken()
            
            <div class="mb-3">
                <label class="form-label fw-bold">Tên Danh mục</label>
                <input type="text" asp-for="Name" class="form-control" required placeholder="Ví dụ: Bánh Mì Hoa Cúc">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Slug (Tùy chọn)</label>
                <input type="text" asp-for="Slug" class="form-control" placeholder="Để trống để tự động tạo slug từ tên">
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả danh mục</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả ngắn gọn về danh mục sản phẩm này"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 20px; background-color: var(--primary-brown); border-color: var(--primary-brown);">Lưu lại</button>
                <a asp-action="Index" class="btn btn-light px-4 py-2" style="border-radius: 20px;">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>
