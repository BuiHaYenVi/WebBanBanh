@model string
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="login-page d-flex justify-content-center align-items-center">
    <div class="login-card p-4 shadow">

        <div class="text-center mb-4">
            <h1 class="h3 fw-bold login-title">Quên mật khẩu</h1>
            <p class="text-muted small">Nhập email đăng ký để nhận lại mật khẩu mới từ <span class="brand-text">SweetBite</span></p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label class="form-label small fw-bold">Địa chỉ Email của bạn</label>
                <input type="email" name="email" placeholder="Nhập email hệ thống..." class="form-control rounded-pill" required />
            </div>

            <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold">GỬI MẬT KHẨU MỚI</button>
        </form>

        <div class="text-center mt-4 pt-3 border-top small">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none brand-link fw-bold">← Quay lại Đăng nhập</a>
        </div>

    </div>
</div>

<style>
    .login-page {
        min-height: 100vh;
        background-color: #fcf8f2;
    }

    .login-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 400px;
        border-radius: 15px;
    }

    .login-title, .brand-text {
        color: #2c1c13;
    }

    .brand-link {
        color: #be9355;
    }

        .brand-link:hover {
            color: #2c1c13;
        }

    .btn-brand {
        background-color: #2c1c13;
        color: #ffffff;
        padding: 10px;
    }

        .btn-brand:hover {
            background-color: #be9355;
            color: #ffffff;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}