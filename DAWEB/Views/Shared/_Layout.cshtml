@using Microsoft.AspNetCore.Http
@using DAWEB.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject DAWEB.Repository.DataContext _dbContext
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _webHostEnv
@inject DAWEB.Services.CartService CartService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SweetBite Bakery</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <!-- Google Fonts for Luxury & Modern Bakery Aesthetic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-brown: #3e2723;
            --accent-gold: #c5a059;
            --light-cream: #faf6f0;
            --accent-peach: #f5ebe6;
            --text-dark: #2b1f1d;
            --text-muted: #7d6e6b;
            --card-shadow: 0 10px 30px rgba(93, 64, 55, 0.08);
            --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Outfit', 'Segoe UI', sans-serif;
            background-color: var(--light-cream);
            color: var(--text-dark);
            -webkit-font-smoothing: antialiased;
        }

        .navbar-custom {
            background-color: var(--primary-brown);
            padding: 16px 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-bottom: 2px solid var(--accent-gold);
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 26px;
            color: #ffffff !important;
            letter-spacing: 1px;
        }

        .navbar-brand span {
            color: var(--accent-gold);
        }

        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 500;
            margin: 0 8px;
            transition: var(--transition-smooth);
            font-size: 15px;
            white-space: nowrap;
        }

        .nav-link:hover {
            color: var(--accent-gold) !important;
            transform: translateY(-1px);
        }

        .cart-icon {
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -10px;
            background: var(--accent-gold);
            color: var(--primary-brown);
            font-weight: bold;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        /* Hover Cart Dropdown */
        .cart-dropdown-container {
            position: relative;
            display: inline-block;
        }

        .cart-dropdown {
            display: block;
            visibility: hidden;
            position: absolute;
            top: 100%;
            right: 0;
            width: 320px;
            background: #ffffff;
            border-radius: 16px;
            z-index: 1050;
            padding: 16px;
            margin-top: 12px;
            border: 1px solid rgba(62, 39, 35, 0.08);
            box-shadow: 0 10px 30px rgba(93, 64, 55, 0.15);
            pointer-events: none;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
        }

        .cart-dropdown::before {
            content: '';
            position: absolute;
            top: -6px;
            right: 20px;
            width: 12px;
            height: 12px;
            background: #ffffff;
            transform: rotate(45deg);
            border-left: 1px solid rgba(62, 39, 35, 0.08);
            border-top: 1px solid rgba(62, 39, 35, 0.08);
        }

        .cart-dropdown.dropdown-left {
            right: auto;
            left: 0;
        }

        .cart-dropdown.dropdown-left::before {
            right: auto;
            left: 20px;
        }

        .cart-dropdown-container:hover .cart-dropdown {
            visibility: visible;
            pointer-events: auto;
            opacity: 1;
            transform: translateY(0);
        }

        #cart-dropdown-items::-webkit-scrollbar {
            width: 6px;
        }
        #cart-dropdown-items::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.02);
            border-radius: 4px;
        }
        #cart-dropdown-items::-webkit-scrollbar-thumb {
            background: rgba(197, 160, 89, 0.3);
            border-radius: 4px;
        }
        #cart-dropdown-items::-webkit-scrollbar-thumb:hover {
            background: var(--accent-gold);
        }

        .cart-item-row {
            transition: background-color 0.2s ease;
        }
        .cart-item-row:hover {
            background-color: rgba(245, 235, 230, 0.2);
        }

        .footer-custom {
            background: var(--primary-brown);
            color: #d7ccc8;
            padding: 50px 0 30px;
            margin-top: 80px;
            border-top: 3px solid var(--accent-gold);
        }

        .footer-custom p {
            margin: 0;
            font-size: 14px;
            color: rgba(255,255,255,0.7);
        }
        
        .footer-brand {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            color: white;
            margin-bottom: 15px;
        }
        
        .footer-brand span {
            color: var(--accent-gold);
        }

        /* Product Cards */
        .product-card {
            border: none;
            border-radius: 16px;
            padding: 20px;
            transition: var(--transition-smooth);
            background: #ffffff;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--card-shadow);
        }

        .product-card:hover {
            box-shadow: 0 20px 40px rgba(93, 64, 55, 0.15);
            transform: translateY(-8px);
        }

        .product-img-container {
            width: 100%;
            height: 220px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            margin-bottom: 20px;
            background-color: var(--accent-peach);
        }

        .product-img-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
            transition: var(--transition-smooth);
        }
        
        .product-card:hover .product-img-container img {
            transform: scale(1.08);
        }

        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .product-price {
            color: var(--accent-gold);
            font-weight: 600;
            font-size: 1.3rem;
        }

        /* Navbar Dropdown Hover for desktop */
        @@media (min-width: 992px) {
            .navbar-nav .nav-item.dropdown:hover .dropdown-menu {
                display: block;
                margin-top: 0;
            }
        }
    </style>
</head>
<body>
    <header>
        @{
            // Lấy tối đa 5 Voucher đang còn hạn sử dụng và còn lượt dùng từ Database
            var activeVouchers = _dbContext.Vouchers
                .Where(v => v.IsActive 
                         && v.StartDate <= DateTime.Now 
                         && v.EndDate >= DateTime.Now 
                         && v.UsedCount < v.UsageLimit)
                .OrderByDescending(v => v.Id)
                .Take(5)
                .ToList();
        }
        
        @if (activeVouchers.Any())
        {
            <!-- Dải băng ngang trên cùng: Carousel Voucher -->
            <div id="voucherCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3000" style="background-color: #2b1f1d; color: white; border-bottom: 1px solid rgba(197, 160, 89, 0.3);">
                <div class="carousel-inner text-center py-2 fw-bold" style="font-size: 14px; letter-spacing: 0.5px;">
                    @for (int i = 0; i < activeVouchers.Count; i++)
                    {
                        var v = activeVouchers[i];
                        string discountText = v.DiscountType == "Percent" ? $"{v.DiscountValue:0.##}%" : $"{v.DiscountValue:N0}đ";
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <i class="fas fa-gift text-warning me-1"></i> 
                            <span class="text-white-50 me-1">ƯU ĐÃI:</span> 
                            Nhập mã <span class="text-warning text-uppercase px-2 py-1 border border-warning rounded mx-1 bg-dark">@v.Code</span> 
                            giảm ngay <span class="text-warning">@discountText</span>
                            @(v.MinimumOrderAmount > 0 ? $" cho đơn từ {v.MinimumOrderAmount:N0}đ" : "")! 
                            <span class="fw-normal opacity-75 ms-2" style="font-size: 12px;"><i class="far fa-clock me-1"></i>HSD: @v.EndDate.ToString("dd/MM")</span>
                        </div>
                    }
                </div>
            </div>
        }

        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Sweet<span>Bite</span> <small style="font-size: 14px; font-weight: 300; letter-spacing: 2px; text-transform: uppercase; margin-left: 5px;">Bakery</small>
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @{
                        var cartCount = CartService.GetCartCount();
                        var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
                    }
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i> Trang chủ</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="/Product" id="productDrop" data-bs-toggle="dropdown"><i class="fas fa-utensils me-1"></i> Thực Đơn</a>
                            <ul class="dropdown-menu shadow border-0">
                                @{
                                    var dbCategories = _dbContext.Categories.OrderBy(c => c.Id).ToList();
                                }
                                @foreach (var category in dbCategories)
                                {
                                    string iconClass = category.Id switch
                                    {
                                        1 => "fa-birthday-cake",
                                        2 => "fa-cookie",
                                        3 => "fa-bread-slice",
                                        _ => "fa-tag"
                                    };
                                    <li><a class="dropdown-item" href="/Product?category=@category.Slug"><i class="fas @iconClass me-2" style="color: var(--accent-gold);"></i> @category.Name &amp; @category.Description</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-bold" href="/Product"><i class="fas fa-th-large me-2" style="color: var(--accent-gold);"></i> Tất cả sản phẩm</a></li>
                            </ul>
                        </li>
                        @{
                            var homeConfigPath = System.IO.Path.Combine(_webHostEnv.WebRootPath, "config", "homepage.json");
                            string hotline = "Liên hệ";
                            if (System.IO.File.Exists(homeConfigPath))
                            {
                                var jsonConfig = System.IO.File.ReadAllText(homeConfigPath);
                                var cfg = System.Text.Json.JsonSerializer.Deserialize<DAWEB.Models.ViewModel.HomePageConfig>(jsonConfig);
                                if (cfg != null && !string.IsNullOrEmpty(cfg.Hotline))
                                {
                                    hotline = cfg.Hotline;
                                }
                            }
                        }
                        <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-phone-alt me-1"></i> @hotline</a></li>
                        <li class="nav-item cart-dropdown-container">
                                <a href="/Cart" class="nav-link cart-icon">
                                    <span class="position-relative d-inline-block me-1">
                                        <i class="fas fa-shopping-bag" style="font-size: 16px;"></i>
                                        <span class="cart-badge" style="top: -8px; right: -8px; padding: 1px 5px; font-size: 9px;">@cartCount</span>
                                    </span>
                                    Giỏ hàng
                                </a>
                                <div class="cart-dropdown shadow dropdown-left" id="hover-cart-dropdown">
                                    <div class="cart-dropdown-header border-bottom pb-2 mb-2">
                                        <span class="fw-bold text-dark" style="font-size: 15px;">
                                            <i class="fas fa-shopping-cart me-2 text-warning" style="color: var(--accent-gold) !important;"></i>Giỏ hàng (<span class="cart-dropdown-count">@cartCount</span>)
                                        </span>
                                    </div>
                                    <div class="cart-dropdown-body" id="cart-dropdown-items" style="max-height: 250px; overflow-y: auto;">
                                        <div class="text-center py-3 text-muted" style="font-size: 13px;">Đang tải...</div>
                                    </div>
                                    <div class="cart-dropdown-footer border-top pt-2 mt-2" style="display: none;">
                                        <div class="d-flex justify-content-between mb-3 text-dark fw-bold" style="font-size: 14px;">
                                            <span>Tổng cộng:</span>
                                            <span class="cart-dropdown-total text-danger">0 đ</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/Cart" class="btn btn-outline-dark btn-sm flex-grow-1 py-2" style="border-radius: 20px; font-size: 12px; font-weight: 600; border-color: var(--primary-brown); color: var(--primary-brown);">
                                                Chi tiết
                                            </a>
                                            <a href="/Cart/Checkout" class="btn btn-primary btn-sm flex-grow-1 py-2" style="border-radius: 20px; font-size: 12px; font-weight: 600; background-color: var(--primary-brown); border-color: var(--primary-brown);">
                                                Thanh toán ngay
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="Index"><i class="fas fa-receipt me-1"></i> Đơn hàng của tôi</a></li>
                            }
                    </ul>

                    <div class="d-flex align-items-center">
                        <!-- Thêm ô tìm kiếm -->
                        <form class="d-flex me-3 search-form" action="/Product" method="get" style="max-width: 250px;">
                            <div class="input-group input-group-sm flex-nowrap">
                                <input class="form-control border-0 shadow-none" type="search" placeholder="Tìm bánh..." name="search" value="@Context.Request.Query["search"]" style="border-radius: 20px 0 0 20px; background-color: var(--accent-peach); min-width: 150px;">
                                <button class="btn btn-outline-light" type="submit" style="border-radius: 0 20px 20px 0; background-color: var(--accent-gold); color: white; border: none;">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </form>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle fw-bold" href="#" data-bs-toggle="dropdown" style="color: var(--accent-gold) !important;">
                                    <i class="fas fa-user-circle me-1"></i> Chào, @User.Identity?.Name!
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item text-primary fw-bold border-bottom" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-user-shield me-2"></i> Quản trị hệ thống</a></li>
                                    }
                                    <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user-cog me-2"></i> Tài khoản</a></li>

                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm me-2 px-3" style="border-color: var(--accent-gold); color: var(--accent-gold);"><i class="fas fa-sign-in-alt me-1"></i> Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer-custom text-center pb-4">
        <div class="container">
            <div class="row text-start text-md-start">
                <!-- Cột 1: Thương hiệu -->
                <div class="col-md-4 mb-4">
                    <div class="footer-brand text-md-start">Sweet<span>Bite</span> Bakery</div>
                    <p class="mb-2 pe-md-4">Thưởng thức hương vị bánh tươi mỗi ngày - Nguyên liệu organic, thơm ngon chuẩn vị Pháp.</p>
                </div>
                <!-- Cột 2: Địa chỉ & Lưu ý -->
                <div class="col-md-4 mb-4">
                    <h5 class="text-white mb-3" style="font-family: 'Playfair Display', serif;">Liên Hệ & Giao Hàng</h5>
                    <p class="mb-2 lh-base" style="font-size: 0.9rem;"><i class="fas fa-map-marker-alt me-2 text-warning" style="color: var(--accent-gold) !important;"></i> Thu Duc Campus: Phân khu Đào tạo E1, Khu Công nghệ cao, Phường Tăng Nhơn Phú, TP.HCM</p>
                    <div class="alert alert-warning py-2 px-3 mt-3 mb-0" style="background-color: rgba(197, 160, 89, 0.1); border-color: rgba(197, 160, 89, 0.3); color: #ffd54f; font-size: 0.85rem;">
                        <i class="fas fa-exclamation-triangle me-1"></i> <strong>Lưu ý:</strong> Chỉ giao hàng trong bán kính từ 8-10km. Nếu ngoài bán kính hoặc lỡ thanh toán, vui lòng tự đến quầy nhận bánh.
                    </div>
                </div>
                <!-- Cột 3: Hòm thư góp ý -->
                <div class="col-md-4 mb-4">
                    <h5 class="text-white mb-2" style="font-family: 'Playfair Display', serif;">Hộp Thư Góp Ý</h5>
                    <p class="mb-3" style="font-size: 0.85rem; color: rgba(255,255,255,0.7);">Nếu đơn giao lâu hoặc sản phẩm bị gì có thể gọi hoặc nhắn tin tại đây:</p>
                    <form action="/Feedback/Submit" method="post" id="feedbackForm">
                        <div class="d-flex gap-2 mb-2">
                            <input type="text" name="CustomerName" class="form-control form-control-sm" placeholder="Tên của bạn" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white;">
                            <input type="text" name="Phone" class="form-control form-control-sm" placeholder="Số điện thoại" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white;">
                        </div>
                        <textarea name="Message" class="form-control form-control-sm mb-2" placeholder="Nhập lời nhắn hoặc khiếu nại..." rows="2" required style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white;"></textarea>
                        <button type="submit" class="btn btn-sm w-100" style="background-color: var(--accent-gold); color: var(--primary-brown); font-weight: bold;">Gửi góp ý</button>
                    </form>
                </div>
            </div>
            <div class="border-top pt-3 mt-2 text-center" style="border-color: rgba(255,255,255,0.1) !important;">
                <p class="mb-0" style="font-size: 0.9rem;">© 2026 SweetBite System - All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        let notificationQueue = [];
        let isShowingNotification = false;

        function showNotification(message, type = 'success', redirectUrl = null) {
            notificationQueue.push({ message, type, redirectUrl });
            processNotificationQueue();
        }

        function processNotificationQueue() {
            if (isShowingNotification || notificationQueue.length === 0) {
                return;
            }

            isShowingNotification = true;
            const { message, type, redirectUrl } = notificationQueue.shift();

            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.position = 'fixed';
                container.style.top = '95px';
                container.style.right = '25px';
                container.style.zIndex = '99999';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = 'toast-msg shadow';
            toast.style.background = type === 'success' ? '#def7ec' : '#fde8e8';
            toast.style.color = type === 'success' ? '#03543f' : '#9b1c1c';
            toast.style.borderLeft = `5px solid ${type === 'success' ? '#31c48d' : '#f05252'}`;
            toast.style.padding = '15px 45px 15px 25px';
            toast.style.marginBottom = '10px';
            toast.style.borderRadius = '12px';
            toast.style.display = 'flex';
            toast.style.alignItems = 'center';
            toast.style.gap = '12px';
            toast.style.minWidth = '320px';
            toast.style.maxWidth = '450px';
            toast.style.fontSize = '14px';
            toast.style.fontWeight = '600';
            toast.style.fontFamily = 'system-ui, -apple-system, sans-serif';
            toast.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
            toast.style.transform = 'translateX(120%)';
            toast.style.opacity = '0';
            toast.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)';
            toast.style.position = 'relative';

            const icon = document.createElement('i');
            icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            icon.style.fontSize = '18px';
            icon.style.color = type === 'success' ? '#31c48d' : '#f05252';
            toast.appendChild(icon);

            const text = document.createElement('span');
            text.style.flex = '1';
            text.innerText = message;
            toast.appendChild(text);

            // Close button (x)
            const closeBtn = document.createElement('button');
            closeBtn.style.position = 'absolute';
            closeBtn.style.right = '15px';
            closeBtn.style.top = '50%';
            closeBtn.style.transform = 'translateY(-50%)';
            closeBtn.style.background = 'none';
            closeBtn.style.border = 'none';
            closeBtn.style.cursor = 'pointer';
            closeBtn.style.color = type === 'success' ? '#03543f' : '#9b1c1c';
            closeBtn.style.opacity = '0.5';
            closeBtn.style.transition = 'opacity 0.2s';
            closeBtn.style.padding = '5px';
            closeBtn.style.display = 'flex';
            closeBtn.style.alignItems = 'center';
            closeBtn.style.justifyContent = 'center';

            const closeIcon = document.createElement('i');
            closeIcon.className = 'fas fa-times';
            closeIcon.style.fontSize = '14px';
            closeBtn.appendChild(closeIcon);

            closeBtn.onmouseenter = () => { closeBtn.style.opacity = '1'; };
            closeBtn.onmouseleave = () => { closeBtn.style.opacity = '0.5'; };
            
            toast.appendChild(closeBtn);
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.transform = 'translateX(0)';
                toast.style.opacity = '1';
            }, 50);

            let dismissTimeout;
            const dismissToast = () => {
                toast.style.transform = 'translateX(120%)';
                toast.style.opacity = '0';
                setTimeout(() => {
                    toast.remove();
                    isShowingNotification = false;
                    processNotificationQueue();
                }, 400);
            };

            const startDismissTimer = () => {
                dismissTimeout = setTimeout(dismissToast, 3000);
            };

            startDismissTimer();

            closeBtn.onclick = function(e) {
                e.stopPropagation();
                clearTimeout(dismissTimeout);
                dismissToast();
            };

            toast.onmouseenter = function() {
                clearTimeout(dismissTimeout);
                if (redirectUrl) {
                    toast.style.transform = 'translateX(0) scale(1.02)';
                    toast.style.boxShadow = '0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.04)';
                }
            };

            toast.onmouseleave = function() {
                if (redirectUrl) {
                    toast.style.transform = 'translateX(0) scale(1)';
                    toast.style.boxShadow = '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)';
                }
                startDismissTimer();
            };

            if (redirectUrl) {
                toast.style.cursor = 'pointer';
                toast.onclick = function() {
                    window.location.href = redirectUrl;
                };
            }
        }

        // Các hàm xử lý giỏ hàng thông minh (Hover Cart)
        function refreshHoverCart() {
            fetch('/Cart/GetCartData')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Cập nhật tất cả các badge số lượng trên trang
                        const cartBadges = document.querySelectorAll('.cart-badge');
                        cartBadges.forEach(badge => {
                            badge.innerText = data.cartCount;
                        });
                        
                        // Cập nhật số lượng trong tiêu đề dropdown
                        const countSpan = document.querySelector('.cart-dropdown-count');
                        if (countSpan) countSpan.innerText = data.cartCount;

                        // Cập nhật tổng tiền trong dropdown
                        const totalSpan = document.querySelector('.cart-dropdown-total');
                        if (totalSpan) totalSpan.innerText = data.cartTotalFormatted;

                        // Hiển thị danh sách sản phẩm
                        const itemsContainer = document.getElementById('cart-dropdown-items');
                        if (!itemsContainer) return;

                        if (data.items.length === 0) {
                            itemsContainer.innerHTML = '<div class="text-center py-4 text-muted"><i class="fas fa-shopping-basket d-block fs-3 mb-2 text-secondary" style="opacity: 0.5;"></i>Giỏ hàng của bạn đang trống.</div>';
                            const footer = document.querySelector('.cart-dropdown-footer');
                            if (footer) footer.style.setProperty('display', 'none', 'important');
                        } else {
                            const footer = document.querySelector('.cart-dropdown-footer');
                            if (footer) footer.style.setProperty('display', 'block', 'important');
                            
                            let html = '';
                            data.items.forEach(item => {
                                html += `
                                <div class="cart-item-row d-flex align-items-center justify-content-between py-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="${item.imageUrl}" alt="${item.productName}" style="width: 45px; height: 45px; object-fit: cover; border-radius: 8px; background-color: var(--accent-peach);" />
                                        <div>
                                            <div class="item-name fw-bold text-dark text-truncate" style="max-width: 120px; font-size: 13px;" title="${item.productName}">${item.productName}</div>
                                            <small class="text-muted" style="font-size: 11px;">${item.priceFormatted}</small>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column align-items-end">
                                        <div class="input-group input-group-sm" style="max-width: 75px; border: 1px solid #ced4da; border-radius: 6px; overflow: hidden;">
                                            <button class="btn btn-light btn-sm px-1 py-0 border-0" type="button" onclick="updateHoverCartQty(${item.productId}, -1)" style="font-size: 10px; font-weight: bold;">-</button>
                                            <input type="text" class="form-control text-center p-0 border-0 fw-bold" value="${item.quantity}" readonly style="font-size: 11px; background-color: #fff; max-width: 25px;" />
                                            <button class="btn btn-light btn-sm px-1 py-0 border-0" type="button" onclick="updateHoverCartQty(${item.productId}, 1)" style="font-size: 10px; font-weight: bold;">+</button>
                                        </div>
                                        <span class="fw-bold text-danger mt-1" style="font-size: 11px;">${item.itemTotal}</span>
                                    </div>
                                </div>
                                `;
                            });
                            itemsContainer.innerHTML = html;
                        }
                    }
                })
                .catch(err => console.error('Lỗi khi cập nhật giỏ hàng:', err));
        }

        function updateHoverCartQty(productId, delta) {
            const event = window.event || arguments.callee.caller.arguments[0];
            const input = event.currentTarget.parentElement.querySelector('input');
            const currentQty = parseInt(input.value);
            const newQty = currentQty + delta;
            
            if (newQty < 1) {
                if (confirm("Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?")) {
                    const formData = new FormData();
                    formData.append('productId', productId);
                    fetch('/Cart/RemoveFromCartAjax', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification("Đã xóa bánh khỏi giỏ hàng", "success");
                            refreshHoverCart();
                            if (window.location.pathname.toLowerCase() === '/cart') {
                                window.location.reload();
                            }
                        }
                    });
                }
                return;
            }

            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('quantity', newQty);

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    refreshHoverCart();
                    if (window.location.pathname.toLowerCase() === '/cart') {
                        window.location.reload();
                    }
                } else {
                    showNotification(data.message, 'error');
                }
            })
            .catch(err => console.error(err));
        }

        // Tải danh sách giỏ hàng khi người dùng hover vào container
        document.addEventListener("DOMContentLoaded", function() {
            const container = document.querySelector('.cart-dropdown-container');
            if (container) {
                container.addEventListener("mouseenter", refreshHoverCart);
            }

            // Enable hover for navbar dropdown on desktop
            const productDrop = document.getElementById("productDrop");
            if (productDrop) {
                productDrop.addEventListener("click", function(e) {
                    if (window.innerWidth >= 992) {
                        window.location.href = this.getAttribute("href");
                    }
                });
            }

            @if (TempData["SuccessMessage"] != null)
            {
                @:showNotification('@Html.Raw(TempData["SuccessMessage"])', 'success');
            }
            @if (TempData["ErrorMessage"] != null)
            {
                @:showNotification('@Html.Raw(TempData["ErrorMessage"])', 'error');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>